# Copied into place as .env on every deploy, so the droplet's .env cannot
# drift or name another environment. Secrets live in backend/.env, which
# this never touches.
COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml

# Pinned, not derived from the directory name: the runtime volume is
# tower-finder-service_runtime-data, and a different project name creates a
# fresh empty one, orphaning the live tower_config.json overlay.
COMPOSE_PROJECT_NAME=tower-finder-service
